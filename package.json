{
  "name": "dsh-sticky-wall",
  "version": "1.0.0",
  "type": "module",
  "description": "Sticky notes on a wall in the DeepSeek Harness sidebar, with four paper stocks, five inks, seven typefaces, four text sizes and your choice of tape, clip or pin.",
  "license": "MIT",
  "author": "hahajing233-source <hahajing233-source@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hahajing233-source/dsh-sticky-wall.git"
  },
  "homepage": "https://github.com/hahajing233-source/dsh-sticky-wall#readme",
  "bugs": {
    "url": "https://github.com/hahajing233-source/dsh-sticky-wall/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sticky-notes",
    "notes",
    "sidebar",
    "ui"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
